			"name": "TC-API-PROD-001 | GET Popular Categories",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "a2da102a-21f8-422e-8053-7028912ee6bf",
						"exec": [
							"// Test 1 - Status code",
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2 - Response is JSON not HTML",
							"pm.test(\"Response is JSON not HTML\", function () {",
							"    var text = pm.response.text();",
							"    pm.expect(text).to.not.include(\"<!DOCTYPE\");",
							"});",
							"",
							"// Test 3 - Response is an array",
							"pm.test(\"Response is an array\", function () {",
							"    var json = pm.response.json();",
							"    pm.expect(json).to.be.an(\"array\");",
							"});",
							"",
							"// Test 4 - Array is not empty",
							"pm.test(\"Categories list is not empty\", function () {",
							"    var json = pm.response.json();",
							"    pm.expect(json.length).to.be.above(0);",
							"});",
							"",
							"// Test 5 - Each category has required fields",
							"pm.test(\"Each category has Id and MenuCategoryName\", function () {",
							"    var json = pm.response.json();",
							"    json.forEach(function(category) {",
							"        pm.expect(category).to.have.property(\"Id\");",
							"        pm.expect(category).to.have.property(\"MenuCategoryName\");",
							"        pm.expect(category).to.have.property(\"Image\");",
							"        pm.expect(category).to.have.property(\"Abbreviation\");",
							"    });",
							"});",
							"",
							"// Test 6 - All categories have IsPopular = True",
							"pm.test(\"All returned categories are marked IsPopular True\", function () {",
							"    var json = pm.response.json();",
							"    json.forEach(function(category) {",
							"        pm.expect(category.IsPopular).to.equal(\"True\");",
							"    });",
							"});",
							"",
							"// Test 7 - Category names are not empty strings",
							"pm.test(\"Category names are not empty\", function () {",
							"    var json = pm.response.json();",
							"    json.forEach(function(category) {",
							"        pm.expect(category.MenuCategoryName).to.not.equal(\"\");",
							"    });",
							"});",
							"",
							"// Test 8 - Response time",
							"pm.test(\"Response time is less than 3000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(3000);",
							"});",
							"",
							"// Save first category EnId for use in next requests",
							"var json = pm.response.json();",
							"if (json.length > 0) {",
							"    pm.collectionVariables.set"
						],
